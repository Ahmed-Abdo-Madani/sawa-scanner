DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sawa
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=false
# Enable weekly HungerStation city/district/branch discovery cron scheduler (accepted values: true|false)
HUNGERSTATION_DISCOVERY_ENABLED=false
# Disable queue processors on this instance to run them locally/on another worker (accepted values: true|false)
DISABLE_QUEUE_PROCESSORS=false
# Clean stale jobs on application startup (dangerous in multi-worker environments; accepted values: true|false)
CLEAN_STALE_JOBS_ON_STARTUP=false
# Disable parallel live web scraping on client requests (accepted values: true|false)
DISABLE_LIVE_SCRAPING=false
# Enable daily HungerStation per-store catalog refresh dispatcher scheduler (accepted values: true|false)
HUNGERSTATION_DAILY_ENABLED=false
# Optional stagger in milliseconds between enqueued daily per-store jobs (default: 30000)
HUNGERSTATION_DAILY_STAGGER_MS=30000
FIREBASE_PROJECT_ID=sawa-scanner
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@sawa-scanner.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
NODE_ENV=development
PORT=3000

# CLOUD_REGION sets the target region for cloud services
# Note: KSA Data Residency Requirement (PDPL Article 29) dictates that
# production deployments must use AWS Bahrain (me-south-1) or GCP Dammam (me-central2-a)
CLOUD_REGION=me-central2-a

# Label Scan Integration
# --- Google AI (via API Key) vs Vertex AI ---
# We recommend using 'vertex' for production deployments of label scan OCR structuring.
# For production, ensure your chosen model is available in your region.
LLM_PROVIDER=vertex

# Google AI credentials (required if LLM_PROVIDER=google-ai or as fallback)
GEMINI_API_KEY=your_gemini_api_key_here
# The gemini-1.5-flash or gemini-2.0-flash model is recommended for OCR label structuring.
# gemini-2.0-flash is NOT available in all regions (esp. Dammam/me-central2)
# NOTE: GEMINI_FALLBACK_MODEL is now used only by OCR label scanning; GTIN matching uses GTIN_AI_MATCH_FALLBACK_MODEL
GEMINI_MODEL=gemini-2.0-flash

# Vertex AI credentials (required if LLM_PROVIDER=vertex)
# Leave these empty or unset to disable Vertex and use Google AI only
GOOGLE_APPLICATION_CREDENTIALS=config/google-cloud-key.json
VERTEX_PROJECT_ID=sawa-scanner
# Important: Model availability varies by region. 
# me-central2 (Dammam) may not have gemini-2.0-flash. Check Google Cloud console.
VERTEX_LOCATION=me-central2

# GTIN Entity Matching Integration (Pass F Backfill)
# These settings govern GTIN matching (NOT OCR label structuring).
# Primary provider is Google AI; Vertex is optional and controlled by GTIN_AI_ENABLE_VERTEX.
GTIN_AI_MATCH_ENABLED=false
# Model for GTIN matching — must be a stable, available model (NOT gemini-2.0-flash)
# Recommended: gemini-1.5-flash (proven stable across regions)
GTIN_AI_MATCH_MODEL=gemini-1.5-flash
# Fallback model if primary model fails (quota exceeded, etc.)
GTIN_AI_MATCH_FALLBACK_MODEL=gemini-1.5-flash-8b
# Enable Vertex AI as the primary provider for GTIN matching (set to true to try Vertex first)
# If false or unset, Google AI is used directly without trying Vertex.
GTIN_AI_ENABLE_VERTEX=false
# Concurrency limit for parallel GTIN matching calls
GTIN_AI_MATCH_CONCURRENCY=1
# Daily budget for GTIN matching API calls (enforced at runtime; skips AI call and marks residual as ai_budget_exhausted when exhausted)
GTIN_AI_MATCH_DAILY_BUDGET=20000

# Dev admin bypass secret (Permitted ONLY in development mode)
DEV_ADMIN_SECRET=your_new_secure_dev_secret_here

# GTIN Backfill configuration
# Dedicated User-Agent for OpenFoodFacts (Required by OFF etiquette)
OFF_BACKFILL_USER_AGENT="SawaScanner/1.0 (admin@sawascanner.com)"

# DEPRECATED: The following variable is no longer used by the backfill engine.
# OFF_BACKFILL_BRANDS was used to filter backfill by brand names, but is now superseded
# by the environment-driven pool configuration (OFF_POOL_COUNTRIES + OFF_POOL_GTIN_PREFIXES).
# If this variable is set without OFF_POOL_BRANDS_OVERRIDE, a warning will be logged at runtime.
# OFF_BACKFILL_BRANDS=

# Per-run cap on brand-alias LLM calls; far fewer unique unknown brands than residual rows so 500 is generous
GTIN_AI_BRAND_ALIAS_BUDGET=500

# ── Brand Alias Cache — Provider Isolation ──────────────────────────────────
# When GTIN_AI_PROVIDER=ollama, brand alias cache entries produced by a
# different provider (e.g. Gemini) may be reused by default.  This can
# pollute Ollama-mode diagnostic runs with Gemini-resolved aliases.
#
# Set GTIN_BRAND_ALIAS_PROVIDER_ISOLATION=true to ignore cross-provider
# entries entirely when GTIN_AI_PROVIDER=ollama.  Entries whose stored
# `provider` field does not contain "Ollama" (case-insensitive) will be
# skipped for override eligibility.
#
# When isolation is OFF (default), cross-provider cache hits are still
# used but are flagged as cross_provider_cache_hit=true in brand_aliases.csv
# so they are easy to filter in post-run analysis.
#
# Recommendation: set to true for diagnostic Ollama runs where you want
# to measure Ollama's own alias resolution quality without Gemini bleed-through.
#
GTIN_BRAND_ALIAS_PROVIDER_ISOLATION=false

# ── GTIN AI Verdict Cache — Provider Isolation ──────────────────────────────
#
# The AI verdict cache (ai-verdicts.json) is shared across providers.
# During diagnostic Ollama runs, Gemini-produced verdicts may satisfy
# cache lookups and mask Ollama-specific quality issues.
#
# Set GTIN_AI_VERDICT_PROVIDER_ISOLATION=true to enable filter-on-read:
# cache hits whose stored `provider` field does not contain the active
# provider name (case-insensitive substring) are rejected with a
# separate cross_provider_cache_hit counter for observability.
#
# CLI flags (trigger-gtin-backfill.ts):
#   --ignore-ai-verdict-cache    Skip all AI verdict cache reads (force fresh LLM calls)
#   --rebuild-ai-cache-isolated  Clear cache + enable provider isolation (implies --rebuild-ai-cache)
#
# Recommendation: use --rebuild-ai-cache-isolated for pure Ollama benchmark runs.
#
GTIN_AI_VERDICT_PROVIDER_ISOLATION=false

# ── GTIN AI Backfill — Cost & Cache Guidance ────────────────────────────────────────────────────
# Cost guidance: Gemini 2.0-flash at typical sizes runs roughly fractions of a US cent per match call.
# 20k daily matches + 500 brand aliases stays well under $5/day at current pricing.
# Operators should consult Google Cloud pricing (https://cloud.google.com/generative-ai/pricing) for their region as the authoritative source of truth.
#
# Cache file locations:
# - `uploads/backfill-cache/ai-verdicts.json`: Verdict cache for Pass F AI matching (cleared by --rebuild-ai-cache CLI flag)
# - `uploads/backfill-cache/brand-aliases.json`: Brand-alias cache, persisted across runs
# - `uploads/backfill-cache/off-embeddings.bin`: Embedding vectors for OFF products (Pass G)
# - `uploads/backfill-cache/off-embeddings.meta.json`: Metadata for embedding cache
#
# Report output: `uploads/backfill-reports/<ISO-timestamp>/`
# - `summary.json`: Full stats, matchTypeBreakdown, runtime metadata, AI counters, average latency
# - `residuals.csv`: Unmatched scans with reason codes, near-miss suggestions, and ai_reason
# - `near_misses.csv`: Top-3 OFF suggestions per residual
# - `review_queue.csv`: Mid-confidence matches pending human review
# - `ai_decisions.csv`: All AI match verdicts (Pass F) with latency and cache hit status
# - `brand_aliases.csv`: All brand-alias LLM calls with resolution results
# - `embedding_decisions.csv`: All embedding shortlist decisions (Pass G) with cosine similarities

# Path to the local OpenFoodFacts JSONL gzip dump file (~1 GB compressed, ~10 GB raw)
# Download from: https://static.openfoodfacts.org/data/openfoodfacts-products.jsonl.gz
# When set, enables dump-based backfill (recommended for reliability)
OFF_DUMP_PATH=./uploads/openfoodfacts-products.jsonl.gz

# ── OFF Pool (GCC Backfill) ────────────────────────────────────────────────────
# Comma-separated OFF country tags to include in the backfill pool (default: GCC)
OFF_POOL_COUNTRIES=saudi-arabia,united-arab-emirates,bahrain,kuwait,qatar,oman
# Comma-separated GS1 prefixes (3-digit) to pull from dump regardless of country tag
OFF_POOL_GTIN_PREFIXES=628,629
# Batch size for bulk INSERT during OFF import (Phase 1)
OFF_IMPORT_BATCH_SIZE=500
# Optional comma-separated brand slug override; when set, these slugs are merged with the built-in GLOBAL_BRANDS_FOR_POOL constant
OFF_IMPORT_GLOBAL_BRANDS=coca-cola,pepsi,almarai,nido,maggi,lipton,red-bull,oreo,pringles,nutella,indomie
# Optional brand slug override — leave empty to skip brand filter. Note: this value now merges with (not replaces) the built-in brand list.
OFF_POOL_BRANDS_OVERRIDE=

# DEPRECATED: OFF_BACKFILL_BRANDS is no longer used by the backfill engine.
# The pool is now driven by OFF_POOL_COUNTRIES + OFF_POOL_GTIN_PREFIXES.
# OFF_BACKFILL_BRANDS=

# ── GTIN Embedding Match (Pass G) ─────────────────────────────────────────────────────────────
# Pass G uses dense embeddings (gemini-embedding-001) for semantic similarity-based candidate ranking.
# It sits between deterministic passes (A–E) and generative Pass F, providing O(N) ANN lookup
# to rank candidates by semantic relevance before sending top-K to the verifier.
# Expected impact: 50%+ improvement in match yield by recovering placeholder-brand and multi-word-brand matches.

# Global on/off for Pass G (can be overridden per run via --embedding CLI flag)
GTIN_EMBEDDING_ENABLED=false
# Embedding model identifier (currently: gemini-embedding-001 for ~$0.02 per million tokens)
GTIN_EMBEDDING_MODEL=gemini-embedding-001
# Matryoshka truncation dimension for storage efficiency (768 keeps memory ≈ 100 MB for 36k OFF products)
GTIN_EMBEDDING_DIM=768
# Task type for embedding generation (OFF index build uses RETRIEVAL_DOCUMENT; queries use RETRIEVAL_QUERY set in code)
GTIN_EMBEDDING_TASK_TYPE=RETRIEVAL_DOCUMENT
# Top-K candidates returned by Pass G shortlist for each scan
GTIN_EMBEDDING_TOPK=10
# Cosine similarity threshold for direct auto-apply (subject to validateAiAutoApply + detectAttributeConflicts gates)
GTIN_EMBEDDING_AUTO_APPLY_COSINE=0.82
# Minimum cosine threshold to escalate borderline matches to Pass F verifier (falls through to residuals if below this)
GTIN_EMBEDDING_VERIFIER_FLOOR_COSINE=0.78
# Batch size for batchEmbedContents API calls during OFF index build (default: 100)
GTIN_EMBEDDING_BATCH_SIZE=100
# Parallel concurrent embedding calls during OFF index build (default: 4)
GTIN_EMBEDDING_CONCURRENCY=2
# Daily budget guard for embedding API calls (enforced at runtime; skips embedding call and marks residual when exhausted)
GTIN_EMBEDDING_DAILY_BUDGET=200000
# Per-call timeout in milliseconds (default: 20000)
GTIN_EMBEDDING_REQUEST_TIMEOUT_MS=20000
# Max per-batch retry attempts on 503/429 before throwing TransientProviderFailureException (default: 2)
GTIN_EMBEDDING_MAX_RETRIES=2

# ── Ollama (Local LLM for GTIN Backfill) ──────────────────────────────────────────────────────
# Prerequisites (run once on the host before enabling):
#   ollama serve                    # daemon must be reachable at OLLAMA_BASE_URL
#   ollama pull gemma3:4b           # primary GTIN-match model
#   ollama pull embeddinggemma      # embedding model for Pass G
# Verify with:  curl http://localhost:11434/api/tags

# Selector: google | ollama. Drives GtinMatchService provider list (consumed in Phase 2).
GTIN_AI_PROVIDER=google
# Selector: google | ollama. Drives the embedding provider factory (consumed in Phase 3).
GTIN_EMBEDDING_PROVIDER=google
# Base URL of the Ollama daemon.
OLLAMA_BASE_URL=http://localhost:11434
# Primary GTIN-match model. Recommend gemma3:12b for GPU hosts.
#OLLAMA_GTIN_MATCH_MODEL=gemma3:4b
OLLAMA_GTIN_MATCH_MODEL=gemma3:1b
# Optional fallback model, e.g., gemma3:1b. Used after primary call exhausts retries.
# OLLAMA_GTIN_MATCH_FALLBACK_MODEL=
# Embedding model (768-dim default — matches existing GTIN_EMBEDDING_DIM=768).
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# Request timeout in milliseconds (higher than Gemini's 30000; first call may include cold model load).
# Recommended: 180000 for low-VRAM/CPU-only diagnostic environments.
OLLAMA_REQUEST_TIMEOUT_MS=420000
# Sent as keep_alive so the model stays resident across thousands of backfill calls.
OLLAMA_KEEP_ALIVE=5m
# Network/5xx retries inside OllamaClient.withRetry.
OLLAMA_MAX_RETRIES=2

# ── Ollama Concurrency (Inner per-operation gates for GTIN Backfill) ──
# Inner per-operation concurrency limits for the Ollama daemon.
# These are independent of GTIN_AI_MATCH_CONCURRENCY (the outer row-level gate).
# Ollama runs a single-threaded model server; saturating it with concurrent
# embedding and chat requests causes cascading timeouts. Conservative defaults
# of 2 prevent saturation on typical hardware (8–16 GB VRAM).
OLLAMA_EMBED_CONCURRENCY=2   # Max concurrent /api/embed calls to Ollama
# Recommended: 1 for low-VRAM/CPU-only diagnostic environments.
OLLAMA_CHAT_CONCURRENCY=1    # Max concurrent /api/chat calls to Ollama

# ── HungerStation Price Linking ────────────────────────────────────────────────
# Maximum number of products to search for on HungerStation per day
HS_PRICE_LINKING_DAILY_BUDGET=5000
# Minimum similarity confidence (0.0 to 1.0) to auto-link and persist prices
HS_PRICE_LINKING_MIN_CONFIDENCE=0.80

# ── Ollama Diagnostic Profile (Fail-Fast & Hard-Stop) ──
# Controls whether a slow preflight probe aborts the run (default: true).
# Set to false to auto-disable Pass F instead of aborting.
OLLAMA_PREFLIGHT_FAIL_FAST=true
# Number of errors allowed in degraded mode before stopping all AI calls (default: 15).
GTIN_AI_HARD_STOP_THRESHOLD=15

# ── Barcode-List.com Name Scraping ─────────────────────────────────────────────
# Scrapes alternative product names from barcode-list.com to improve
# HungerStation price linking hit rates. Names from this source are closer
# to retail POS naming conventions than Open Food Facts names.

# Base delay in milliseconds between HTTP requests to barcode-list.com (jitter is added automatically)
BARCODE_LIST_REQUEST_DELAY_MS=2000
# Maximum number of GTINs to look up per run
BARCODE_LIST_DAILY_BUDGET=5000

# ── HungerStation Catalog Scraper (HS Pivot) ──────────────────────────────────
# Scrapes the full product catalog from a single HungerStation store branch.
# Products are identified by their HS-internal product ID (hs_product_id)
# and stored WITHOUT a GTIN — admins later assign GTINs via the mobile scanner.
HS_CATALOG_STORE_URL=https://hungerstation.com/sa-en/qc/65969/AL-Othaim/branch/fa269bef-9ae0-4877-ace8-272d61be145d~142939
# Limit categories to scrape (0 = all)
HS_CATALOG_MAX_CATEGORIES=0
# Limit products per category (0 = all)
HS_CATALOG_MAX_PRODUCTS_PER_CAT=0
# Delay between requests in milliseconds (lower = faster but riskier for anti-bot)
HS_CATALOG_REQUEST_DELAY_MS=2000

# ── Salla/Etaam Express Scraper ────────────────────────────────────────────────
# Configurable navigation request delay in milliseconds (default: 3000)
# A random jitter (80% to 120%) is automatically added to this base delay.
ETAAM_SCRAPER_REQUEST_DELAY_MS=3000

# Toggle to bypass robots.txt constraints during backfills (accepted values: true|false)
BYPASS_ROBOTS_TXT=false

# Clean stale/zombie active jobs on module initialization.
# Should be set to false in multi-worker environments to avoid clearing jobs actively running on other workers.
CLEAN_STALE_JOBS_ON_STARTUP=false

